<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Stay Extension Receipt · <%= booking.reference_id %></title>
<link rel="stylesheet" href="/css/receipt.css?v=2">
<style>
.extension-receipt{max-width:760px;margin:30px auto;background:#fffdf8;color:#292823;box-shadow:0 24px 80px #0002;font:14px/1.6 Arial,sans-serif}.extension-head{padding:36px 44px;background:#212320;color:#fffdf8;border-bottom:3px solid #a49b83}.extension-head h1{font:42px Georgia,serif;margin:18px 0 4px}.extension-body{padding:34px 44px}.extension-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:20px;margin:24px 0;background:#f2efe7}.extension-grid strong{display:block;font:18px Georgia,serif}.extension-charge{display:flex;justify-content:space-between;border-top:1px solid #ddd;padding:18px 0;font:20px Georgia,serif}.extension-note{color:#777;font-size:12px}.extension-actions{max-width:760px;margin:18px auto;display:flex;justify-content:flex-end;gap:8px}.extension-actions button{padding:10px 16px;cursor:pointer}@media(max-width:600px){.extension-receipt{margin:12px}.extension-head,.extension-body{padding:24px}.extension-head h1{font-size:32px}.extension-grid{padding:14px;gap:12px}}
@media print{body{background:white!important}.extension-actions{display:none}.extension-receipt{margin:0;box-shadow:none}.extension-head{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style></head><body class="receipt-page">
<%
const currency=value=>(Number(value||0)/100).toLocaleString('en-NG',{style:'currency',currency:'NGN'});
const date=value=>new Date(value).toLocaleDateString('en-NG',{day:'2-digit',month:'short',year:'numeric',timeZone:'Africa/Lagos'});
%>
<div class="extension-actions"><button type="button" onclick="window.print()">Print / Save PDF</button></div>
<article class="extension-receipt">
<header class="extension-head"><span>VISTAVILLA APARTMENTS · LAGOS</span><h1>Stay Extension Receipt</h1><span>Booking reference: <%= booking.reference_id %></span></header>
<section class="extension-body">
<div><span class="receipt-label">PREPARED FOR</span><strong><%= booking.guest_name %></strong><br><span>Room <%= booking.room_number %></span></div>
<div class="extension-grid"><div><span class="receipt-label">PREVIOUS CHECKOUT</span><strong><%= date(extension.old_end) %></strong></div><div><span class="receipt-label">NEW CHECKOUT</span><strong><%= date(extension.new_end) %></strong></div><div><span class="receipt-label">NIGHTS ADDED</span><strong><%= extension.added_nights %></strong></div><div><span class="receipt-label">EXTENSION PRICE</span><strong><%= currency(extension.additional_amount) %></strong></div></div>
<div class="extension-charge"><span>Payment received for this extension</span><strong><%= currency(extension.amount_paid_now) %></strong></div>
<div class="extension-charge"><span>Extension balance after payment</span><strong><%= currency(extension.balance_after) %></strong></div>
<p class="extension-note">This receipt records the additional stay charge and the payment received when the extension was made. Earlier booking payments are not included in the payment amount above.</p>
</section></article></body></html>
