<!doctype html>
<html lang="en">
<head>
<script src="/js/theme.js?v=1"></script>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vistavilla Apartment — A quieter kind of luxury</title>
<meta name="description" content="<%= content.introduction %>">
<meta name="theme-color" content="#202923"><link rel="stylesheet" href="/css/landing.css">
<link rel="stylesheet" href="/css/theme.css?v=5">
<link rel="manifest" href="/manifest.webmanifest?v=3">
<link rel="apple-touch-icon" sizes="180x180" href="/images/vistavilla-app-180.png?v=3">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Vistavilla">
<link rel="stylesheet" href="/css/pwa.css?v=1">
<script defer src="/js/pwa.js?v=2"></script>
<link rel="icon" type="image/png" sizes="192x192" href="/images/vistavilla-app-192.png?v=3">
</head>
<body>
<header class="site-header">
<a class="wordmark" href="/" aria-label="Vistavilla home">VISTAVILLA<span>APARTMENT · LAGOS</span></a>
<button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span>☰</span></button>
<nav id="navigation" aria-label="Main navigation"><a href="/rooms">Our apartments</a><a href="/gallery">The gallery</a><a href="#contact">Find us</a><a class="button small" href="/rooms">Reserve your stay ↗</a></nav>
</header>
<% if (activeMarquees) { %><aside class="announcement"><%= activeMarquees.text %></aside><% } %>
<main>
<section class="hero" aria-labelledby="hero-title">
<img class="hero-photo" src="<%= content.heroImage %>" alt="A welcoming space at Vistavilla Apartment" fetchpriority="high" decoding="async">
<div class="hero-shade"></div>
<div class="hero-content"><p class="eyebrow"><span></span><%= content.eyebrow %></p><h1 id="hero-title"><%= content.headline %></h1><p class="hero-description"><%= content.introduction %></p><a class="button light" href="/rooms">Discover your stay <span>↗</span></a></div>
<div class="hero-bottom"><span>YOUR CITY. YOUR SPACE. YOUR PACE.</span><a href="#discover">Scroll to discover ↓</a></div>
<div class="hero-number" aria-hidden="true">01 / LAGOS</div>
</section>
<div class="welcome-strip"><span>STAY A LITTLE LONGER.</span><p>An address to arrive at. A feeling to return to.</p><a href="/rooms">Explore apartments ↗</a></div>
<% if (content.showAbout) { %>
<section class="about section" id="discover" aria-labelledby="about-title">
<div class="about-copy"><p class="eyebrow muted">THE VISTAVILLA WAY</p><h2 id="about-title"><%= content.aboutTitle %></h2><p><%= content.aboutText %></p><a class="text-link" href="/gallery">A closer look <span>↗</span></a><div class="signature">Make yourself at home.</div></div>
<div class="about-photo"><img src="<%= content.aboutImage %>" alt="Considered interiors at Vistavilla" loading="lazy" decoding="async" width="700" height="820"><span class="photo-note">CONSIDERED SPACES. MEMORABLE STAYS.</span></div>
</section>
<% } %>
<% if (content.showRooms) { %>
<section class="rooms section" id="apartments" aria-labelledby="rooms-title">
<div class="section-heading"><div><p class="eyebrow muted">THE COLLECTION</p><h2 id="rooms-title"><%= content.roomsTitle %></h2></div><a class="text-link" href="/rooms">All apartments ↗</a></div>
<div class="room-grid">
<% pkgs.slice(0,3).forEach((room, index) => { %>
<article class="room-card"><a class="room-photo" href="/rooms"><img src="<%= room.picture && room.picture[0] ? room.picture[0] : content.heroImage %>" alt="<%= room.category_name %>" loading="lazy" decoding="async" width="600" height="720"><span class="room-count">0<%= index + 1 %></span><span class="room-arrow" aria-hidden="true">↗</span></a><div class="room-info"><h3><a href="/rooms"><%= room.category_name %></a></h3><p><% if (Number(room.price) > 0) { %>From <strong>₦<%= Number(room.price).toLocaleString('en-NG') %></strong> / night<% } else { %>Explore your next stay<% } %></p><% if (room.hasSpecialPrice) { %><span class="offer">Special rate available</span><% } %></div></article>
<% }); %>
<% if (!pkgs.length) { %><p>Find your next stay. <a href="/rooms">Browse availability ↗</a></p><% } %>
</div></section>
<% } %>
<% if (content.showAmenities) { %>
<section class="amenities section" aria-labelledby="amenities-title"><div><p class="eyebrow">THE DETAILS THAT MATTER</p><h2 id="amenities-title">An effortless<br>everyday.</h2><p>Room to settle in. Reasons to stay.</p></div><div class="amenity-list"><% content.amenities.split('\n').filter(line => line.trim()).slice(0,12).forEach((line,index) => { %><div><span>0<%= index + 1 %></span><h3><%= line %></h3><span aria-hidden="true">↗</span></div><% }); %></div></section>
<% } %>
<section class="stay section"><p class="eyebrow muted">YOUR NEXT CHAPTER STARTS HERE</p><h2>A change of scenery.<br>A familiar feeling.</h2><a class="button" href="/rooms">Find your apartment ↗</a></section>
</main>
<footer id="contact"><div class="footer-main"><div><a class="wordmark" href="/">VISTAVILLA<span>APARTMENT · LAGOS</span></a><p>Where every view feels like home.</p><button class="install-link" id="install-app" hidden>Install Vistavilla ↗</button><p id="install-help" class="install-help">Keep us close: add Vistavilla to your home screen from your browser menu.</p></div><div><h3>COME FIND US</h3><p><%= content.address %></p><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(content.address) %>" target="_blank" rel="noopener">Get directions ↗</a></div><div><h3>LET’S TALK</h3><a href="tel:<%= content.phone.replace(/[^+\d]/g, '') %>"><%= content.phone %></a><a href="mailto:<%= content.email %>"><%= content.email %></a><a href="/page-contact">Contact us ↗</a></div></div><div class="footer-bottom"><span>© <%= new Date().getFullYear() %> Vistavilla Apartment</span><a href="/terms-and-conditions">Terms & conditions</a><span>LAGOS, NIGERIA</span></div></footer>
<script defer src="/js/landing.js"></script>
</body></html>
