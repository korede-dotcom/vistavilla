<%- include('partial/header', { title: 'Vistavilla Apartment',email:email,roleName:roleName }) %>
<%- include('partial/sidebar', { name: name}) %>


<div class="page-wrapper">
<div class="content mt-5">
<div class="row">
<div class="col-sm-5 col-4">
<h4 class="page-title">Booking Details</h4>
</div>
<div class="col-sm-7 col-8 text-right m-b-30">
<div class="btn-group btn-group-sm">
<% if (!bookings.checked_out && ['success','confirmed','part-payment','completed'].includes(bookings.status)) { %>
<button class="btn btn-primary" data-toggle="modal" data-target="#extendStayModal">Extend Stay</button>
<% } %>
<button class="btn btn-warning" data-toggle="modal" data-target="#transferRoomModal">
	<i class="fas fa-exchange-alt"></i> Transfer Room
</button>
<!-- <button class="btn btn-primary">CSV</button>
<button class="btn btn-primary">PDF</button>
<button class="btn btn-primary"><i class="fas fa-print fa-lg"></i> Print</button> -->
</div>
</div>
</div>

<% const guestCredit = Math.max(0, Number(bookings.amount_paid || 0) - Number(bookings.amount)); %>
<% if (guestCredit > 0) { %><div class="alert alert-info">Guest credit owed: <strong>₦<%= (guestCredit/100).toLocaleString('en-NG') %></strong>. Preserved from the room downgrade; available against later charges. No refund has been sent automatically.</div><% } %>
<% if (Number(bookings.discount_total || 0) > 0 || Number(bookings.discount_per_night || 0) > 0) { %>
<div class="alert alert-info">Recorded discount: <strong><%= bookings.discount_type === 'percentage' ? Number(bookings.discount_value) + '%' : bookings.discount_scope === 'booking' ? '₦' + Number(bookings.discount_value || 0).toLocaleString('en-NG') + ' flat off booking total' : '₦' + (Number(bookings.discount_per_night || 0)/100).toLocaleString('en-NG') + ' per night' %></strong>. Total discount: ₦<%= (Number(bookings.discount_total || Number(bookings.discount_per_night || 0)*Number(bookings.night))/100).toLocaleString('en-NG') %>.</div>
<% } %>
