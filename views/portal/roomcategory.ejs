<%- include('partial/header', { title: 'Vistavilla Apartment',email:email,roleName:roleName }) %>
<%- include('partial/sidebar', { name: name}) %>
		<div class="page-wrapper">
			<div class="content container-fluid">
				<div class="page-header">
					<div class="row align-items-center">
						<div class="col">
							<div class="mt-5">
								
								<h4 class="card-title mt-2">All Room Categories</h4>
                                <% if (['ceo','hotelmanager','hotel receptionist'].includes(roleName)) { %>
                                <div class="d-flex flex-wrap mb-3" style="gap:10px">
                                    <a href="/portal/add-room" class="btn btn-primary">Add Room</a>
                                    <a href="/portal/add-room-category" class="btn btn-primary">Add Room Category</a>
                                </div>
                                <% } %>
                            </div>
						</div>
					</div>
				</div> 
				<div class="row">
					<div class="col-sm-12">
						<div class="card card-table">
							<div class="card-body booking_card">
								<div class="table-responsive">
									<table class="datatable table table-stripped table table-hover table-center mb-0">
										<thead>
											<tr>
												<th>category ID</th>
												<th>Name</th>
												<th>Room Type</th>
												<th>Room Count</th>
												<th>Amount</th>
												<th>No Bed</th>
												<th>No Guest</th>
												<th>Date created</th>
												<% if (['ceo','hotelmanager','hotel receptionist'].includes(roleName)) { %>
												<th class="text-right">Actions</th>
												<% } %>
											</tr>
										</thead>
										<tbody>
											<% categories.forEach(result => { %>
												<tr data-content-id="<%= result._id %>">
													<td><%= result._id %></td>
													<td>
														<h2 class="table-avatar">
															<a href="#" onclick="openCategoryEditor(<%= result._id %>); return false;" class="avatar avatar-sm mr-2">
																<img class="avatar-img rounded-circle" src="<%= (result.picture||[])[0] || '/images/logo.png' %>" alt="User Image">
															</a>
															<a href="#" onclick="openCategoryEditor(<%= result._id %>); return false;"><%= result.category_name %><span>#0001</span></a>
														</h2>
													</td>
													<td><%= result.room_type %></td>
													<td><%= result.roomcount %></td>
													<td><%= result.price %></td>
													<td><%= result.num_beds %></td>
													<td><%= result.number_of_guests %></td>
													<td><%= new Date(result.createdAt).toISOString().slice(0, 10).replace(/-/g, '/') %></td>
													<% if (['ceo','hotelmanager','hotel receptionist'].includes(roleName)) { %>
													<td class="text-right">

														<div class="dropdown dropdown-action">
															<a href="#" class="action-icon dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
																<i class="fas fa-ellipsis-v ellipse_color"></i>
															</a>
															<div class="dropdown-menu dropdown-menu-right">
																<a class="dropdown-item" href="#" onclick="openCategoryEditor(<%= result._id %>); return false;">
																	<i class="fas fa-pencil-alt m-r-5"></i> Edit
																</a>
																<a class="dropdown-item delete-btn" href="#" data-toggle="modal" data-target="#delete_asset" data-id="<%= result._id %>">
																	<i class="fas fa-trash-alt m-r-5"></i> Delete
																</a>
															</div>
														</div>
													</td>
													<% } %>
												</tr>
											<% }) %>
										</tbody>
									</table>
									
									<!-- Delete Confirmation Modal -->
									<div id="delete_asset" class="modal fade delete-modal" role="dialog">
										<div class="modal-dialog modal-dialog-centered">
											<div class="modal-content">
												<div class="modal-body text-center">
													<img src="/portal/assets/img/sent.png" alt="" width="50" height="46">
													<h3 class="delete_class">Are you sure you want to delete this Asset?</h3>
													<div class="m-t-20">
														<a href="#" class="btn btn-white" data-dismiss="modal">Close</a>
														<button id="confirm-delete-btn" class="btn btn-danger">Delete</button>
													</div>
												</div>
											</div>
										</div>
									</div>
									
									<!-- JavaScript -->
									<script>
										document.addEventListener('DOMContentLoaded', () => {
											let deleteId;
									
											// Event delegation for delete buttons
											document.querySelector('.datatable tbody').addEventListener('click', function(e) {
												if (e.target.closest('.delete-btn')) {
													deleteId = e.target.closest('.delete-btn').dataset.id;
													console.log("ID to delete: ", deleteId);
												}
											});
									
											// Confirm delete action
											document.getElementById('confirm-delete-btn').addEventListener('click', () => {
												if (deleteId) {
													console.log("Deleting item with ID:", deleteId);
													// Perform the delete operation here, e.g., send a request to the server
													window.location.href = `/portal/room-category?type=delete&id=${deleteId}`
													// fetch(`/portal/room-category?type=delete&id=${deleteId}`)
													// .then(response => window.portalResponseJSON(response))
													// .then(data => {
													// 	if (data.success) {
													// 		console.log('Deleted Successfully');
													// 		window.location.reload();
													// 	}
													// })
													// .catch(error => console.error('Error:', error));
													
												}
											});
										});
									</script>
									
									<!-- <button class="button primary"
										>Open dialog</button> -->
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			
		</div>
<div id="categoryEditorModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="categoryEditorTitle"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
<div class="modal-header"><h5 id="categoryEditorTitle" class="modal-title">Edit room category</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
<form id="categoryEditorForm" style="display:flex;flex-direction:column;min-height:0"><div class="modal-body"><p class="text-muted">Changes apply to this category and its rooms. Existing booking totals stay unchanged.</p><div class="row"><div class="col-md-6 form-group"><label for="category-category_name">Category name</label><input class="form-control" id="category-category_name" name="category_name" type="text" maxlength="255" required></div><div class="col-md-6 form-group"><label for="category-room_type">Room type</label><input class="form-control" id="category-room_type" name="room_type" type="text" maxlength="255" required></div><div class="col-md-6 form-group"><label for="category-price">Nightly price (₦)</label><input class="form-control" id="category-price" name="price" type="number" step="0.01" min="0.01" max="99999999.99" required></div><div class="col-md-6 form-group"><label for="category-num_beds">Number of beds</label><input class="form-control" id="category-num_beds" name="num_beds" type="number" step="1" min="1" max="1000" required></div><div class="col-md-6 form-group"><label for="category-number_of_guests">Guest capacity</label><input class="form-control" id="category-number_of_guests" name="number_of_guests" type="number" step="1" min="1" max="1000" required></div><div class="col-md-6 form-group"><label for="category-food">Meal plan</label><input class="form-control" id="category-food" name="food" type="text" maxlength="255" required></div><div class="col-md-6 form-group"><label for="category-cancellations_fee">Cancellation fee</label><input class="form-control" id="category-cancellations_fee" name="cancellations_fee" type="text" maxlength="255"></div><div class="col-12 form-group"><label for="category-description">Description</label><textarea class="form-control" id="category-description" name="description" rows="3" maxlength="10000" required></textarea></div></div>
<div class="d-flex flex-wrap" style="gap:20px"><label><input type="checkbox" name="has_ac"> Air conditioning</label><label><input type="checkbox" name="has_wifi"> Wi-Fi</label><label><input type="checkbox" name="status"> Published / active</label></div>
<section class="mt-3" aria-label="Category photos"><h6>Category photos</h6><p class="text-muted">Photo changes save immediately. Removing a photo here only removes it from this category; it remains in the website gallery.</p><div id="categoryPhotoGallery" class="row"></div><label for="categoryPhotoUpload">Add photos</label><input id="categoryPhotoUpload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" multiple><small class="text-muted">Up to 10 photos per upload, 10 MB each. Public photos are stored in the images folder.</small><button type="button" id="uploadCategoryPhotos" class="btn btn-secondary mt-2" disabled>Upload photos</button></section>
<p id="categoryEditorMessage" role="status" class="mt-3"></p></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button type="submit" id="saveCategory" class="btn btn-primary" disabled>Save category</button></div></form></div></div></div>
<script src="/js/category-editor.js" defer></script>
		<script data-cfasync="false" src="../../../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
		<script src="/portal/assets/js/jquery-3.5.1.min.js"></script>
		<script src="/portal/assets/js/popper.min.js"></script>
		<script src="/portal/assets/js/bootstrap.min.js"></script>
		<script src="/portal/assets/plugins/slimscroll/jquery.slimscroll.min.js"></script>
		<script src="/portal/assets/plugins/raphael/raphael.min.js"></script>
		<script src="/portal/assets/plugins/datatables/jquery.dataTables.min.js"></script>
		<script src="/portal/assets/plugins/datatables/datatables.min.js"></script>
		<script src="/portal/assets/js/script.js"></script>
		<script src="https://cdn.metroui.org.ua/current/metro.js"></script>
	
	</body>
	
	</html>