<%- include('partial/header', { title: 'Part Payments - Vistavilla Apartment',email:email,roleName:roleName }) %>
<%- include('partial/sidebar', { name: name}) %>

<style>
.payment-log-tabs{display:flex;gap:8px;padding:6px;background:#e9eef3;border-radius:14px;width:max-content;max-width:100%;margin:18px 0 16px}
.payment-log-tab{border:0!important;border-radius:10px!important;padding:11px 18px!important;color:#415267!important;background:transparent!important;font-weight:600!important;box-shadow:none!important}
.payment-log-tab.active{background:#fff!important;color:#1c2830!important;box-shadow:0 2px 8px #172b4d18!important}
#extensionLogsPanel .card{border:1px solid #e5eaf0;box-shadow:0 8px 28px #1c28300d}
#extensionLogsPanel .table-responsive{border:1px solid #e8edf2;border-radius:12px}
#extensionLogsPanel table{min-width:1050px}
#extensionLogsPanel thead th{background:#f3f6f9;color:#526273;font-size:12px;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;border:0;padding:14px}
#extensionLogsPanel tbody td{padding:14px;vertical-align:middle;white-space:nowrap}
@media(max-width:767.98px){.payment-log-tabs{display:grid;grid-template-columns:1fr 1fr;width:100%;gap:4px;margin:10px 0 14px}.payment-log-tab{padding:10px 8px!important;font-size:14px!important}.page-header .veiwbutton{float:none!important;display:inline-flex;margin-top:12px}.page-header .card-title{float:none!important;line-height:1.35}.page-wrapper>.content>p{font-size:14px!important;line-height:1.5;margin:10px 15px!important}#extensionLogsPanel .card-body{padding:16px}#extensionLogsPanel .card-title{font-size:18px}}
</style>

<div class="page-wrapper">
    <div class="content container-fluid">
        <p class="mt-3">Guests with unpaid booking balances, including room upgrades and extended stays. View the balance due and use the payment action to record money received.</p>
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col">
                    <div class="mt-5">
                        <h4 class="card-title float-left mt-2">
                            <i class="fas fa-money-bill-wave" style="color: #FFA500;"></i> Part Payments — Guests Owing
                        </h4>
                        <a href="/portal/add-booking" class="btn btn-primary float-right veiwbutton">
                            <i class="fas fa-plus"></i> New Booking
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card board1 fill">
                    <div class="card-body">
                        <div class="dash-widget-header">
                            <div>
                                <h3 class="card_widget_header"><%= partPayments.length %></h3>
                                <h6 class="text-muted">Total Part Payments</h6>
                            </div>
                            <div class="ml-auto mt-md-3 mt-lg-0">
                                <span class="opacity-7 text-muted">
                                    <i class="fas fa-list fa-2x" style="color: #FFA500;"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card board1 fill">
                    <div class="card-body">
                        <div class="dash-widget-header">
                            <div>
                                <h3 class="card_widget_header">
                                    ₦<%= partPayments.reduce((sum, p) => sum + (p.amount_paid / 100), 0).toLocaleString() %>
                                </h3>
                                <h6 class="text-muted">Total Collected</h6>
                            </div>
                            <div class="ml-auto mt-md-3 mt-lg-0">
                                <span class="opacity-7 text-muted">
                                    <i class="fas fa-check-circle fa-2x" style="color: #28a745;"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card board1 fill">
                    <div class="card-body">
                        <div class="dash-widget-header">
                            <div>
                                <h3 class="card_widget_header" style="color: #dc3545;">
                                    ₦<%= partPayments.reduce((sum, p) => sum + (p.balance / 100), 0).toLocaleString() %>
                                </h3>
                                <h6 class="text-muted">Total Balance Due</h6>
                            </div>
                            <div class="ml-auto mt-md-3 mt-lg-0">
                                <span class="opacity-7 text-muted">
                                    <i class="fas fa-exclamation-circle fa-2x" style="color: #dc3545;"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card board1 fill">
                    <div class="card-body">
                        <div class="dash-widget-header">
                            <div>
                                <h3 class="card_widget_header">
                                    <%= partPayments.filter(p => p.payment_status === 'partial').length %>
                                </h3>
                                <h6 class="text-muted">Pending Payments</h6>
                            </div>
                            <div class="ml-auto mt-md-3 mt-lg-0">
                                <span class="opacity-7 text-muted">
                                    <i class="fas fa-clock fa-2x" style="color: #FFA500;"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="payment-log-tabs" role="tablist" aria-label="Payment records">
            <button type="button" class="payment-log-tab active" data-target="partPaymentsPanel" aria-selected="true">Part Payments</button>
            <button type="button" class="payment-log-tab" data-target="extensionLogsPanel" aria-selected="false">Extend Stay Logs</button>
        </div>
        <div id="partPaymentsPanel">
        <div class="row">
            <div class="col-sm-12">
                <div class="card card-table">
                    <div class="card-body booking_card">
                        <!-- Date Filter and Download Section -->
                        <div class="mb-4">
                            <form method="get" action="/portal/part-payments" id="filterForm">
                                <div class="row align-items-end">
                                    <div class="col-md-3">
                                        <label for="start_date" class="font-weight-bold">
                                            <i class="fas fa-calendar-alt"></i> Start Date
                                        </label>
                                        <input type="date" id="start_date" name="start" class="form-control">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="end_date" class="font-weight-bold">
                                            <i class="fas fa-calendar-alt"></i> End Date
                                        </label>
                                        <input type="date" id="end_date" name="end" class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <button type="submit" class="btn btn-primary mr-2">
                                            <i class="fas fa-filter"></i> Filter
                                        </button>
                                        <button type="button" id="download-csv" class="btn btn-success mr-2">
                                            <i class="fas fa-download"></i> Download CSV
                                        </button>
                                        <a href="/portal/part-payments" class="btn btn-secondary">
                                            <i class="fas fa-redo"></i> Reset
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table class="datatable table table-stripped table table-hover table-center mb-0">
                                <thead>
                                    <tr>
                                        <th>S/N</th>
                                        <th>Reference ID</th>
                                        <th>Guest Details</th>
                                        <th>Room Details</th>
                                        <th>Total Amount</th>
                                        <th>Amount Paid</th>
                                        <th>Balance</th>
                                        <th>Booking Period</th>
                                        <th>Status</th>
                                        <th>Payment Log / Receipt</th>
                                        <th class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (partPayments.length === 0) { %>
                                        <tr>
                                            <td colspan="11" class="text-center">
                                                <div class="py-5">
                                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                                    <p class="text-muted">No part payments found</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% partPayments.forEach((payment, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td>
                                                    <span class="badge badge-info" style="font-size: 11px;">
                                                        <%= payment.reference_id %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <h2 class="table-avatar">
                                                        <a href="javascript:void(0);" class="avatar avatar-sm mr-2">
                                                            <i class="fas fa-user-circle fa-2x" style="color: #6b6b6b;"></i>
                                                        </a>
                                                        <a href="javascript:void(0);">
                                                            <%= payment.guest_name %><br>
                                                            <span style="font-size: 11px; color: #999;">
                                                                <i class="fas fa-phone"></i> <%= payment.guest_phone || 'N/A' %>
                                                            </span>
                                                        </a>
                                                    </h2>
                                                </td>
                                                <td>
                                                    <strong><%= payment.room_name %></strong><br>
                                                    <% if (payment.is_room_transfer) { %>
                                                    <span class="badge badge-warning">Room changed: <%= payment.previous_room_number %> → <%= payment.room_number %></span><br>
                                                    <% } %>
                                                    <span class="badge badge-secondary" style="font-size: 10px;">
                                                        <i class="fas fa-door-open"></i> <%= payment.room_number %>
                                                    </span>
                                                    <br>
                                                    <small class="text-muted"><%= payment.nights %> night(s)</small>
                                                </td>
                                                <td>
                                                    <strong>₦<%= (payment.total_amount / 100).toLocaleString() %></strong>
                                                </td>
                                                <td>
                                                    <span style="color: #28a745; font-weight: bold;">
                                                        ₦<%= (payment.amount_paid / 100).toLocaleString() %>
                                                    </span>
                                                    <br>
                                                    <small class="text-muted">
                                                        <%= Math.round((payment.amount_paid / payment.total_amount) * 100) %>% paid
                                                    </small>
                                                </td>
                                                <td>
                                                    <span style="color: #dc3545; font-weight: bold; font-size: 14px;">
                                                        ₦<%= (payment.balance / 100).toLocaleString() %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <small>
                                                        <i class="fas fa-calendar-check" style="color: #28a745;"></i>
                                                        <%= new Date(payment.start_date).toLocaleDateString('en-GB') %>
                                                    </small>
                                                    <br>
                                                    <small>
                                                        <i class="fas fa-calendar-times" style="color: #dc3545;"></i>
                                                        <%= new Date(payment.end_date).toLocaleDateString('en-GB') %>
                                                    </small>
                                                </td>
                                                <td>
                                                    <% if (payment.payment_status === 'partial') { %>
                                                        <span class="badge badge-pill" style="background-color: #FFA500; color: white; padding: 5px 10px;">
                                                            <i class="fas fa-clock"></i> Partial
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge badge-pill badge-success" style="padding: 5px 10px;">
                                                            <i class="fas fa-check-circle"></i> Completed
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% const logs=paymentLogs[payment._id]||[]; if(logs.length){ logs.forEach(log=>{ %>
                                                        <div class="mb-2"><small><%= new Date(log.payment_date).toLocaleString('en-GB') %> · ₦<%= (Number(log.payment_amount)/100).toLocaleString() %></small><br>
                                                        <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="/portal/payment-receipt/<%= log._id %>"><i class="fas fa-receipt"></i> Generate Receipt</a></div>
                                                    <% }); } else { %><small class="text-muted">No payment history recorded</small><% } %>
                                                    <% const stays=extensionLogs[payment._id]||[]; stays.forEach(stay=>{ %>
                                                        <div class="mt-2"><small>Stay extension · <%= stay.added_nights %> night(s) · ₦<%= (Number(stay.additional_amount)/100).toLocaleString() %></small><br>
                                                        <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" href="/portal/extension-receipt/<%= stay.id %>"><i class="fas fa-receipt"></i> Extension Receipt</a></div>
                                                    <% }); %>
                                                </td>
                                                <td class="text-right">
                                                    <% if (payment.payment_status === 'partial') { %>
                                                        <a href="/portal/complete-payment?id=<%= payment._id %>"
                                                           class="btn btn-sm btn-primary"
                                                           style="background-color: #6b6b6b; border-color: #6b6b6b;">
                                                            <i class="fas fa-money-bill-wave"></i> Complete Payment
                                                        </a>
                                                        <% if(['ceo','hotelmanager','hotel receptionist'].includes(roleName)){ %><button type="button" class="btn btn-sm btn-outline-danger clear-balance-button" data-id="<%= payment._id %>" data-guest="<%= payment.guest_name %>" data-balance="<%= payment.balance %>">Clear Balance</button><% } %>
                                                    <% } else { %>
                                                        <span class="badge badge-success">
                                                            <i class="fas fa-check"></i> Paid in Full
                                                        </span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <div id="extensionLogsPanel" class="row" style="display:none">
            <div class="col-sm-12"><div class="card card-table"><div class="card-body booking_card">
                <h5 class="card-title">Stay Extension Logs</h5>
                <p class="text-muted">Each record shows the extension charge and payment received at the time of extension.</p>
                <div class="table-responsive"><table class="table table-hover table-center mb-0"><thead><tr><th>Date</th><th>Reference</th><th>Guest</th><th>Room</th><th>Previous checkout</th><th>New checkout</th><th>Nights added</th><th>Extension price</th><th>Paid now</th><th>Balance after</th><th>Receipt</th></tr></thead><tbody>
                <% if(!allExtensions.length){ %><tr><td colspan="11" class="text-center text-muted">No stay extensions recorded</td></tr><% } else { allExtensions.forEach(extension=>{ %>
                    <tr><td><%= new Date(extension.createdAt||extension.created_at||extension.old_end).toLocaleString('en-GB') %></td><td><%= extension.reference_id %></td><td><%= extension.guest_name %></td><td><%= extension.room_number %></td><td><%= new Date(extension.old_end).toLocaleDateString('en-GB') %></td><td><%= new Date(extension.new_end).toLocaleDateString('en-GB') %></td><td><%= extension.added_nights %></td><td>₦<%= (Number(extension.additional_amount||0)/100).toLocaleString() %></td><td>₦<%= (Number(extension.amount_paid_now||0)/100).toLocaleString() %></td><td>₦<%= (Number(extension.balance_after||0)/100).toLocaleString() %></td><td><a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="/portal/extension-receipt/<%= extension.id %>"><i class="fas fa-receipt"></i> Generate Receipt</a></td></tr>
                <% }); } %></tbody></table></div>
            </div></div></div>
        </div>
    </div>
</div>

<script src="/portal/assets/js/jquery-3.5.1.min.js"></script>
<script src="/portal/assets/js/popper.min.js"></script>
<script src="/portal/assets/js/bootstrap.min.js"></script>
<script src="/portal/assets/plugins/slimscroll/jquery.slimscroll.min.js"></script>
<script src="/portal/assets/plugins/datatables/jquery.dataTables.min.js"></script>
<script>
document.querySelectorAll('.payment-log-tab').forEach(button=>button.addEventListener('click',()=>{
 document.getElementById('partPaymentsPanel').style.display=button.dataset.target==='partPaymentsPanel'?'':'none';
 document.getElementById('extensionLogsPanel').style.display=button.dataset.target==='extensionLogsPanel'?'':'none';
 document.querySelectorAll('.payment-log-tab').forEach(tab=>{const active=tab===button;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',String(active));});
}));
</script>
<script src="/portal/assets/plugins/datatables/datatables.min.js"></script>
<script src="/portal/assets/js/script.js"></script>

<script>
    // Handle CSV download
    document.getElementById('download-csv').addEventListener('click', function(e) {
        e.preventDefault();

        const startDate = document.getElementById('start_date').value;
        const endDate = document.getElementById('end_date').value;

        // Build the request URL
        let requestUrl = '/portal/part-payments-csv';
        const params = [];

        if (startDate) params.push(`start=${startDate}`);
        if (endDate) params.push(`end=${endDate}`);

        if (params.length > 0) {
            requestUrl += '?' + params.join('&');
        }

        // Create an anchor element to trigger download
        const link = document.createElement('a');
        link.href = requestUrl;
        link.click();
    });
</script>

<% if(['ceo','hotelmanager'].includes(roleName)){ %>
<section class="page-wrapper" style="min-height:0"><div class="content container-fluid"><div class="card"><div class="card-body"><h4>Cleared balances — latest 100</h4><p>Amounts waived without receiving payment. Full history is also available in Activity Logs.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Date</th><th>Customer / booking</th><th>Room</th><th>Amount cleared</th><th>Cleared by</th><th>Reason</th></tr></thead><tbody>
<% (typeof clearances!=='undefined'?clearances:[]).forEach(item=>{ %><tr><td><%= new Date(item.createdAt).toLocaleString('en-NG',{timeZone:'Africa/Lagos'}) %></td><td><%= item.guest_name %><br><%= item.reference_id %></td><td><%= item.room_number %></td><td>₦<%= (item.amount/100).toLocaleString('en-NG') %></td><td><%= item.cleared_by_name %></td><td style="white-space:normal"><%= item.reason %></td></tr><% }); %>
</tbody></table></div></div></div></div></section><% } %>
<div id="clearBalanceModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="clearBalanceTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="clearBalanceTitle">Clear unpaid balance</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button></div><form id="clearBalanceForm"><div class="modal-body"><p id="clearBalanceSummary"></p><p>This waives the balance. No money will be recorded as received. The CEO and manager can review the reason and your name.</p><label for="clearBalanceReason">Reason (required)</label><textarea id="clearBalanceReason" class="form-control" required minlength="5" maxlength="1000" rows="3"></textarea><p id="clearBalanceMessage" role="status" class="mt-3"></p></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button type="submit" id="confirmClearBalance" class="btn btn-danger" disabled>Clear Balance</button></div></form></div></div></div>
<script src="/js/clear-balance.js" defer></script>
</body>
</html>

