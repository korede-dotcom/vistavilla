<!DOCTYPE html>
<html lang="en">

<head>
<script src="/js/pwa.js?v=4"></script>
<script src="/js/theme.js?v=1"></script>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Vistavilla Apartment</title>
	<link rel="stylesheet" href="/portal/assets/css/bootstrap.min.css">
	<link rel="stylesheet" href="/portal/assets/plugins/fontawesome/css/all.min.css">
	<link rel="stylesheet" href="/portal/assets/plugins/fontawesome/css/fontawesome.min.css">
	<link rel="stylesheet" href="/portal/assets/css/style.css">
	<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
	<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

	<style>
			.loader {
			width: 24px;
			height: 24px;
			border: 3px solid #FFF;
			border-bottom-color: #FF3D00;
			border-radius: 50%;
			display: inline-block;
			box-sizing: border-box;
			animation: rotation 1s linear infinite;
		}

		@keyframes rotation {
			0% {
				transform: rotate(0deg);
			}
			100% {
				transform: rotate(360deg);
			}
		} 
		.login-wrapper .loginbox .login-left {
			background:linear-gradient(135deg, #000 0%,  #6b6b6b 52%, #6b6b6b 100%, #6b6b6b 100%)#fdd869 ;
		}
	</style>

<link rel="stylesheet" href="/css/theme.css?v=5">
<link rel="manifest" href="/portal-manifest.webmanifest?v=1">
<link rel="apple-touch-icon" sizes="180x180" href="/images/vistavilla-app-180.png?v=3">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Vistavilla">
<link rel="stylesheet" href="/css/pwa.css?v=2">
<link rel="icon" type="image/png" sizes="192x192" href="/images/vistavilla-app-192.png?v=3">
<link rel="stylesheet" href="/css/camera-upload.css?v=1">
<script defer src="/js/camera-upload.js?v=1"></script>
</head>

<body>
	<div class="main-wrapper login-body">
		<div class="login-wrapper">
			<div class="container">
				<div class="loginbox">
					<div class="login-left"> <img class="img-fluid" src="/images/logo-2.png" alt="Logo"> </div>
					<div class="login-right">
						<div class="login-right-wrap">
							<% if (status) { %>
							  <!-- When status is true -->
							 
							  <h1>Password?</h1>
							  <p class="account-subtitle">Enter your new password</p>
							
							  
							  <form id="resetPasswordForm">
								<div class="form-group">
								  <input class="form-control" id="password" type="password" placeholder="Password" required>
								</div>
								<div class="form-group">
								  <input class="form-control" id="confirmPassword" type="password" placeholder="Confirm Password" required>
								</div>
								<div class="form-group">
								  <input type="checkbox" id="togglePassword" onclick="togglePasswordVisibility()"> Show Password
								</div>
								<div class="form-group mb-0">
								  <button class="btn btn-primary btn-block" type="submit">Reset Password</button>
								</div>
							  </form>
							  
							  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
							  <script>
								function togglePasswordVisibility() {
								  const password = document.getElementById('password');
								  const confirmPassword = document.getElementById('confirmPassword');
								  const type = password.type === 'password' ? 'text' : 'password';
								  password.type = type;
								  confirmPassword.type = type;
								}
							  
								document.getElementById('resetPasswordForm').addEventListener('submit', async function(event) {
								  event.preventDefault();
								  
								  const password = document.getElementById('password').value;
								  const confirmPassword = document.getElementById('confirmPassword').value;
								  const url = new URL(window.location.href);
								  const id = url.searchParams.get('id');
							  
								  // Validate password match
								  if (password !== confirmPassword) {
									Toastify({
									  text: "Passwords do not match!",
									  duration: 3000,
									  close: true,
									  gravity: "top",
									  position: "center",
									  stopOnFocus: true,
									  style: {
										background: "linear-gradient(to right, #FF5F6D, #FFC371)",
									  }
									}).showToast();
									return;
								  }
							  
								  // Post the data to /recovery
								  try {
									const response = await fetch('/auth/change-password', {
									  method: 'POST',
									  headers: { 'Content-Type': 'application/json' },
									  body: JSON.stringify({ password,token:id })
									});
									const data = await response.json();
							  
									// Handle the response
									if (data.status === true) {
									  Toastify({
										text: data.message,
										duration: 3000,
										close: true,
										gravity: "top",
										position: "center",
										stopOnFocus: true,
										style: {
										  background: "linear-gradient(to right, #00b09b, #96c93d)",
										}
									  }).showToast();
									  
									  // Redirect to /portal
									  setTimeout(() => {
										window.location.href = '/portal';
									  }, 3000);
							  
									} else {
									  Toastify({
										text: data.message || "An error occurred!",
										duration: 3000,
										close: true,
										gravity: "top",
										position: "center",
										stopOnFocus: true,
										style: {
										  background: "linear-gradient(to right, #FF5F6D, #FFC371)",
										}
									  }).showToast();
									}
								  } catch (error) {
									// Handle any request errors
									Toastify({
									  text: "Request failed, please try again.",
									  duration: 3000,
									  close: true,
									  gravity: "top",
									  position: "center",
									  stopOnFocus: true,
									  style: {
										background: "linear-gradient(to right, #FF5F6D, #FFC371)",
									  }
									}).showToast();
								  }
								});
							  </script>
							  
							  
							  <div class="text-center dont-have">Remember your password? <a href="/portal">Login</a></div>
							<% } else { %>
							  <!-- When status is false -->
							  <h1>Link Expired Generate a new one</h1>
							  <p class="account-subtitle">Use the forgot password option</p>
							  <div class="text-center dont-have"> <a href="/portal/forgot-password">Generate again </a></div>
							<% } %>
						  </div>
						  
					</div>
				</div>
			</div>
		</div>
	</div>
	<script src="/portal/assets/js/jquery-3.5.1.min.js"></script>
	<script src="/portal/assets/js/popper.min.js"></script>
	<script src="/portal/assets/js/bootstrap.min.js"></script>
	<script src="/portal/assets/js/script.js"></script>
	<script>
		document.getElementById('resetPasswordForm').addEventListener('submit', async function (event) {
			event.preventDefault();  // Prevent the form from submitting the default way
	
			// Get the value from the email input field
			const email = document.getElementById('email').value;
	
			if (!email) {
				alert('Please enter your email');
				return;
			}
	
			// Prepare the data to send
			const data = {
				email: email
			};
	
			try {
				// Send the POST request to /auth/reset-password
				const response = await fetch('/auth/reset-password', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify(data)
				});
				const data = await response.json();
				// Handle the response
				if (response.status) {
					Toastify({
				text: data.message,
				duration: 3000,
				//destination: "https://github.com/apvarun/toastify-js",
				newWindow: true,
				close: true,
				gravity: "top", // `top` or `bottom`
				position: "center", // `left`, `center` or `right`
				stopOnFocus: true, // Prevents dismissing of toast on hover
				style: {
					background: "linear-gradient(to right, #00b09b, #96c93d)",
				},
				onClick: function(){} // Callback after click
				}).showToast();
				} else {
					const errorData = await response.json();
					Toastify({
				text: errorData.message,
				duration: 3000,
				//destination: "https://github.com/apvarun/toastify-js",
				newWindow: true,
				close: true,
				gravity: "top", // `top` or `bottom`
				position: "center", // `left`, `center` or `right`
				stopOnFocus: true, // Prevents dismissing of toast on hover
				style: {
					background: "red",
				},
				onClick: function(){} // Callback after click
				}).showToast();
					
				}
			} catch (error) {
				console.error('Error:', error);
				alert('There was an error processing your request.');
			}
		});
	</script>
	
</body>

</html>