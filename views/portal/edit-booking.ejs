<%- include('partial/header',{title:'Edit Booking - Vistavilla Apartments',email,roleName}) %>
<%- include('partial/sidebar',{name}) %>
<link rel="stylesheet" href="/css/booking-editor.css?v=1">
<div class="page-wrapper"><main class="content container-fluid booking-editor">
<header class="booking-editor-heading"><div><a class="booking-editor-back" href="/portal/check-in?key=<%= encodeURIComponent(booking.reference_id) %>">← Booking details</a><h1>Edit booking</h1><p>Update the stay, review the figures, then save.</p></div><div class="booking-editor-reference"><span>BOOKING REFERENCE</span><strong><%= booking.reference_id %></strong><small>Room <%= booking.room_number %> · <%= booking.room_name %></small></div></header>
<form id="editBookingForm" data-reference="<%= booking.reference_id %>">
<input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="expected_version" value="<%= defaults.expected_version %>">
<div class="booking-editor-layout"><div class="booking-editor-fields">
<section class="booking-editor-card"><div class="booking-editor-section-heading"><span class="booking-editor-number">01</span><div><h2>Guest details</h2><p>The person staying with us.</p></div></div><div class="booking-editor-grid">
<% for(const [key,label] of [['guest_name','Full name'],['guest_email','Email address'],['guest_phone','Phone number'],['guest_address','Address']]){ %>
<div class="booking-editor-field"><label for="<%= key %>"><%= label %></label><input class="form-control" id="<%= key %>" name="<%= key %>" value="<%= booking[key] %>" maxlength="255" required></div>
<% } %>
<div class="booking-editor-field"><label for="guest_count">Number of guests</label><input class="form-control" type="number" id="guest_count" name="guest_count" min="1" max="100" step="1" value="<%= booking.guest_count %>" required></div></div></section>
<section class="booking-editor-card"><div class="booking-editor-section-heading"><span class="booking-editor-number">02</span><div><h2>Stay & pricing</h2><p>All amounts are in Nigerian naira.</p></div></div><div class="booking-editor-grid">
<div class="booking-editor-field"><label for="edit_start">Check-in date</label><input class="form-control" type="date" id="edit_start" name="start" value="<%= defaults.start %>" required></div>
<div class="booking-editor-field"><label for="edit_end">Checkout date</label><input class="form-control" type="date" id="edit_end" name="end" value="<%= defaults.end %>" required></div>
<div class="booking-editor-field"><label for="rate">Nightly rate (₦)</label><input class="form-control" type="number" id="rate" name="rate" step="0.01" min="0.01" value="<%= defaults.rate %>" required></div>
<div class="booking-editor-field"><label for="discount_type">Discount type</label><select class="form-control" id="discount_type" name="discount_type"><option value="flat" <%= defaults.discount_type==='flat'?'selected':'' %>>Flat amount off total (₦)</option><option value="percentage" <%= defaults.discount_type==='percentage'?'selected':'' %>>Percentage of subtotal (%)</option></select></div>
<div class="booking-editor-field"><label for="discount_value">Discount value</label><input class="form-control" type="number" id="discount_value" name="discount_value" min="0" step="0.01" value="<%= defaults.discount_value %>" required></div>
</div><p class="booking-editor-note">Changing dates, rate or discount recalculates the whole stay. Use Transfer Room to change the room. Caution fees stay unchanged.</p></section>
<section class="booking-editor-card"><div class="booking-editor-section-heading"><span class="booking-editor-number">03</span><div><h2>Payment & reason</h2><p>Earlier receipts remain credited.</p></div></div><div class="booking-editor-grid">
<div class="booking-editor-field"><label for="amount_paid_now">Additional payment received (₦)</label><input class="form-control" type="number" id="amount_paid_now" name="amount_paid_now" step="0.01" min="0" value="0" required><small>Enter only new money already received.</small></div>
<div class="booking-editor-field"><label for="payment_method">Payment method</label><select class="form-control" name="payment_method" id="payment_method"><option value="cash">Cash</option><option value="transfer">Bank transfer</option><option value="card">Card</option></select></div>
<div class="booking-editor-field booking-editor-wide"><label for="reason">Reason for this edit</label><textarea class="form-control" id="reason" name="reason" rows="3" maxlength="1000" placeholder="Briefly describe what changed and why…" required></textarea></div>
</div></section>
</div>
<aside class="booking-editor-summary booking-editor-card" aria-label="Booking calculation preview"><span class="booking-editor-eyebrow">REVIEW BEFORE SAVING</span><h2>Booking summary</h2><p class="booking-editor-note">Calculate to check availability and review the revised amounts.</p>
<dl><div><dt>Room subtotal</dt><dd data-edit-value="subtotal">—</dd></div><div><dt>Discount</dt><dd data-edit-value="discountTotal">—</dd></div><div class="booking-editor-total"><dt>Booking total</dt><dd data-edit-value="total">—</dd></div><div><dt>Previously paid</dt><dd data-edit-value="previousPaid">—</dd></div><div><dt>New payment</dt><dd data-edit-value="paidNow">—</dd></div><div><dt>Balance due</dt><dd data-edit-value="balance">—</dd></div><div><dt>Guest credit</dt><dd data-edit-value="credit">—</dd></div></dl>
<p id="bookingEditSummary" class="booking-editor-status" role="status">Changes have not been calculated.</p>
<button class="btn btn-secondary" type="button" id="previewBookingEdit">Calculate changes</button><button class="btn btn-primary" type="submit" id="saveBookingEdit" disabled>Save booking changes</button><a class="booking-editor-cancel" href="/portal/check-in?key=<%= encodeURIComponent(booking.reference_id) %>">Cancel & return</a>
</aside></div></form>
<div class="booking-editor-section-heading"><h2>Edit history</h2><p>Staff, reasons and recorded financial changes.</p></div><div class="card booking-editor-history"><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>When / staff</th><th>Reason</th><th>Dates before → after</th><th>Room total before → after</th><th>Paid now</th><th>New balance / credit</th></tr></thead><tbody>
<% revisions.forEach(revision=>{ %><tr><td><%= new Date(revision.createdAt).toLocaleString('en-NG') %><br><%= revision.edited_by %></td><td><%= revision.reason %></td><td><%= new Date(revision.before.start).toLocaleDateString('en-NG') %>–<%= new Date(revision.before.end).toLocaleDateString('en-NG') %><br>→ <%= new Date(revision.after.start).toLocaleDateString('en-NG') %>–<%= new Date(revision.after.end).toLocaleDateString('en-NG') %></td><td>₦<%= (revision.before.total/100).toLocaleString('en-NG') %> → ₦<%= (revision.after.total/100).toLocaleString('en-NG') %></td><td>₦<%= (revision.amount_paid_now/100).toLocaleString('en-NG') %></td><td>Balance: ₦<%= (revision.after.balance/100).toLocaleString('en-NG') %><br>Credit: ₦<%= (Math.max(0,revision.after.amount_paid-revision.after.total)/100).toLocaleString('en-NG') %></td></tr><% }); %>
<% if(!revisions.length){ %><tr><td colspan="6">No booking edits recorded yet.</td></tr><% } %></tbody></table></div></div></div>

</main></div>
<script defer src="/js/edit-booking.js?v=2"></script>
<%- include('partial/footer') %>
