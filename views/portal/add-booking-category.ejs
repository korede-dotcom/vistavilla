    <script src="/js/booking-pricing.js?v=2"></script>
    <script>
        // Function to open the modal
        let room_id, room_name, room_number;
      
        
        // Function to open the modal when a room is clicked
        function openModal(roomNumber, roomName, roomStatus, roomId) {
            const modal = document.getElementById('roomModal');
            room_id = roomId;
            room_name = roomName;
            room_number = roomNumber;
        
            // Set modal content
            document.getElementById('modalRoomNumber').innerText = "Room " + roomNumber;
            document.getElementById('modalRoomName').innerText = roomName;
            document.getElementById('modalRoomStatus').innerText = roomStatus;
        
            // Show the modal
            modal.style.display = "flex";
        }
        
        // Function to close the modal
        function closeModal() {
            const modal = document.getElementById('roomModal');
            modal.style.display = "none";
        }
        
        // Ensure modal is hidden when the page loads
        document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById('roomModal');
    modal.style.display = "none"; // Hide modal on page load

    const url = new URL(window.location.href);
    let price = 0; // Fetch the authoritative rate for the selected check-in date.
    const categoryId = url.searchParams.get('id');
    let pricingReady = false, priceRequest = 0;

    // Display initial price
    document.querySelector('#price').innerText = `₦${price.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

    // Helper to format date as 'YYYY-MM-DD'
    const formatDate = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    };

    // Set default dates for check-in and check-out
    const setDefaultDates = () => {
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(today.getDate() + 1);

        document.getElementById('checkIn').value = formatDate(today);
        document.getElementById('checkOut').value = formatDate(tomorrow);
    };

    setDefaultDates(); // Initialize default dates

    // Fetch special pricing for selected dates
    async function fetchSpecialPricing(checkInDate) {
        const revision = ++priceRequest; pricingReady = false;
        document.getElementById('bookingPriceSummary').textContent = 'Fetching the room rate…';
        try {
            const response = await fetch(`/portal/api/pricing/category/${categoryId}?date=${checkInDate}`);
            if (!response.ok) throw Error('Unable to fetch room pricing');
            if (response.ok) {
                const data = await window.portalResponseJSON(response);
                if (revision !== priceRequest) return;
                if (!data.status) throw Error(data.message || 'Unable to fetch room pricing');
                pricingReady = true;
                if (data.status && data.data.hasSpecialPrice) {
                    price = parseFloat(data.data.price);
                    const config = data.data.pricingConfig;
                    const startDate = new Date(config.start_date).toLocaleDateString('en-NG', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                    const endDate = new Date(config.end_date).toLocaleDateString('en-NG', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });

                    document.querySelector('#price').innerText = `₦${price.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2})} (Special Price)`;

                    console.log('✅ Special pricing applied:', {
                        price,
                        duration: `${startDate} - ${endDate}`,
                        configName: config.config_name
                    });

                    // Show pricing info card
                    const pricingCard = document.getElementById('pricingInfoCard');
                    const pricingConfigName = document.getElementById('pricingConfigName');
                    const pricingDuration = document.getElementById('pricingDuration');
                    const pricingAmount = document.getElementById('pricingAmount');
                    const pricingDescription = document.getElementById('pricingDescription');

                    pricingCard.style.display = 'block';
                    pricingConfigName.textContent = config.config_name || 'Special Pricing';
                    pricingDuration.textContent = `${startDate} - ${endDate}`;
                    pricingAmount.textContent = `₦${price.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2})} / night`;

                    if (config.description) {
                        pricingDescription.textContent = config.description;
                        pricingDescription.style.display = 'block';
                    } else {
                        pricingDescription.style.display = 'none';
                    }

                    // Add animation
                    pricingCard.style.animation = 'fadeInDown 0.5s ease-out';
                } else {
                    price = Number(data.data.price);
                    document.querySelector('#price').innerText = `₦${price.toLocaleString('en-NG', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    console.log('✅ Using regular pricing:', price);

                    // Hide pricing info card
                    const pricingCard = document.getElementById('pricingInfoCard');
                    pricingCard.style.display = 'none';
                }
                renderPriceSummary();
            }
        } catch (error) {
            if (revision !== priceRequest) return;
            pricingReady = false;
            document.getElementById('bookingPriceSummary').textContent = 'Unable to load room pricing. Change the date to retry.';
            console.error('Room pricing unavailable:', error);
        }
    }

    // Handle part payment checkbox
    const isPartPaymentCheckbox = document.getElementById('isPartPayment');
    const partPaymentAmountDiv = document.getElementById('partPaymentAmountDiv');
    const amountPaidInput = document.getElementById('amount_paid');
    const paymentModeSelect = document.getElementById('paymentmode');
    const guestCountInput = document.getElementById('guest_count');
    const guestChargeInput = document.getElementById('extra_guest_charge');

    function priceQuote() {
        if (!pricingReady) throw Error('Wait for the current room rate to load.');
        const room = BookingPricing.quote({start:document.getElementById('checkIn').value,end:document.getElementById('checkOut').value,
          rate:price,discountType:document.getElementById('discount_type').value,discountValue:document.getElementById('discount_per_night').value || '0'});
        const guestCount=BookingPricing.guestCount(guestCountInput.value);
        const extraGuestCharge=BookingPricing.moneyInKobo(guestChargeInput.value, 'Extra guest charge');
        return {...room,guestCount,extraGuestCharge,total:BookingPricing.withExtraGuestCharge(room.total,extraGuestCharge)};
    }

    function renderPriceSummary() {
      const target=document.getElementById('bookingPriceSummary');
      const money=value=>(value/100).toLocaleString('en-NG',{style:'currency',currency:'NGN'});
      try {
        const q=priceQuote();
        const partial=isPartPaymentCheckbox.checked;
        const paid=partial?BookingPricing.moneyInKobo(amountPaidInput.value || '0','Amount received'):q.total;
        target.textContent=`${q.nights} night(s) × ${money(q.rate)}. Guests: ${q.guestCount}. Room subtotal: ${money(q.subtotal)}. Room discount${q.discountType==='percentage'?' ('+q.discountValue+'%)':''}: ${money(q.discountTotal)}. Extra guest charge: ${money(q.extraGuestCharge)}. Booking total: ${money(q.total)}. ${partial?'Received':'Due now'}: ${money(paid)}. Balance: ${money(Math.max(0,q.total-paid))}.`;
        if(partial&&paid>q.total)target.textContent+=' Enter a payment within the booking total.';
      } catch(error) {target.textContent=error.message;}
    }

    for(const id of ['checkIn','checkOut','discount_per_night','discount_type','guest_count','extra_guest_charge','amount_paid','isPartPayment','paymentmode']) {
      document.getElementById(id).addEventListener('input',()=>queueMicrotask(renderPriceSummary));
      document.getElementById(id).addEventListener('change',()=>queueMicrotask(renderPriceSummary));
    }
    document.getElementById('discount_type').addEventListener('change',()=>{
      const input=document.getElementById('discount_per_night');
      if(document.getElementById('discount_type').value==='percentage')input.max='100';else input.removeAttribute('max');
    });
    document.getElementById('checkIn').addEventListener('change',function(){return fetchSpecialPricing(this.value);});

    function updatePartPayment() {
      isPartPaymentCheckbox.disabled=paymentModeSelect.value!=='Cash';
      if(isPartPaymentCheckbox.disabled)isPartPaymentCheckbox.checked=false;
      const partial=isPartPaymentCheckbox.checked;
      partPaymentAmountDiv.style.display=partial?'block':'none';
      amountPaidInput.disabled=!partial;
      amountPaidInput.required=partial;
      renderPriceSummary();
    }
    isPartPaymentCheckbox.addEventListener('change',updatePartPayment);
    paymentModeSelect.addEventListener('change',updatePartPayment);
    updatePartPayment();
    fetchSpecialPricing(document.getElementById('checkIn').value);

    // Handle form submission
    document.getElementById('submit_button').addEventListener('click', async (event) => {
        event.preventDefault(); // Prevent default form submission
        const isPartPayment = isPartPaymentCheckbox.checked;
        let currentQuote, amountPaid;
        try {
            currentQuote=priceQuote();
            if(isPartPayment)amountPaid=BookingPricing.recordedPayment(currentQuote.total,BookingPricing.moneyInKobo(amountPaidInput.value,'Amount received'));
        } catch(error) { showToast(error.message, 'red'); return; }

        // Retrieve form values
        const checkInDate = document.getElementById('checkIn').value;
        const checkOutDate = document.getElementById('checkOut').value;
        const guestName = document.querySelector('input[name="guest_name"]').value;
        const guestPhone = document.querySelector('input[name="guest_phone"]').value;
        const guestEmail = document.querySelector('input[name="guest_email"]').value;
        const guestAddress = document.querySelector('input[name="guest_address"]').value;
        const paymentMode = document.querySelector('select[name="paymentmode"]').value;

        const loader = document.querySelector('.loader');
        const submitButton = document.getElementById('submit_button');

        // Show loader and disable submit button
        loader.style.display = 'inline-block';
        submitButton.disabled = true;

        // Field validation
        if (!checkInDate || !checkOutDate || !guestName) {
            showToast("Please fill out all required fields.", "red");
            resetLoader(loader, submitButton);
            return;
        }

        if (paymentMode === "customer-self-payment" && (!guestPhone || !guestEmail)) {
            showToast("Email & phone number are required for customer payment link.", "red");
            resetLoader(loader, submitButton);
            return;
        }

        // Ensure check-out date is after check-in date
        if (new Date(checkInDate) >= new Date(checkOutDate)) {
            showToast("Check-out date must be after check-in date.", "red");
            resetLoader(loader, submitButton);
            return;
        }

        // Validate email format if provided
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (guestEmail && !emailPattern.test(guestEmail)) {
            showToast("Please enter a valid email address.", "red");
            resetLoader(loader, submitButton);
            return;
        }

        // Prepare payload for backend
        const id = url.searchParams.get('id');
        const cateName = url.searchParams.get('cat_id');

        // Use FormData to support file upload
        const formData = new FormData();
        formData.append('allow_past_booking', document.getElementById('allowPastBooking').checked);
        formData.append('backdated_reason', document.getElementById('backdatedReason').value);
        formData.append('start', checkInDate);
        formData.append('end', checkOutDate);
        formData.append('guest_name', guestName);
        formData.append('guest_email', guestEmail || '-');
        formData.append('guest_phone', guestPhone || '-');
        formData.append('guest_address', guestAddress || '-');
        formData.append('mode', paymentMode);
        formData.append('category_id', id);
        formData.append('room_id', room_id);
        formData.append('room_name', room_name);
        formData.append('room_number', room_number);
        formData.append('category_name', cateName);
        formData.append('is_part_payment', isPartPayment);
        if (isPartPayment) formData.append('amount_paid', amountPaid);
        formData.append('guest_count', currentQuote.guestCount);
        formData.append('extra_guest_charge', (currentQuote.extraGuestCharge / 100).toFixed(2));
        formData.append('discount_type', currentQuote.discountType);
        formData.append('discount_value', currentQuote.discountValue);
        formData.append('discount_per_night', currentQuote.discountPerNight);

        // Add ID card file if selected
        const idCardInput = document.getElementById('id_card');
        if (idCardInput.files && idCardInput.files[0]) {
            formData.append('image', idCardInput.files[0]);
        }

        if (paymentMode === "Generate-Bank-Transfer" && (!guestPhone || !guestEmail)) {
            formData.set('guest_email', "vistavillaapartment@gmail.com");
            formData.set('guest_phone', "09111458637");
        }

        // Send the payment initialization request
        const response = await fetch("/payments/paystack/initialize/reception", {
            method: 'POST',
            body: formData, // Send FormData instead of JSON
        });
        
        const data = await window.portalResponseJSON(response);
        resetLoader(loader, submitButton);

        if (!data.status) {
            showToast(data.message, "red");
            return;
        }

        // Handle response based on payment mode
        if (paymentMode === "Generate-Bank-Transfer" && data.data.authorization_url) {
            loadPaymentIframe(data.data.authorization_url);
        } else if (paymentMode === "Cash") {
            showToast(data.message, "green");
            window.location.reload();
        } else {
            showToast("Payment link sent to customer's email and phone.", "green");
        }
    });

    // Reset loader and enable button
    function resetLoader(loader, button) {
        loader.style.display = 'none';
        button.disabled = false;
    }

    // Load Paystack payment iframe
    function loadPaymentIframe(url) {
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.width = "100%";
        iframe.height = "700px"; // Adjust the height as necessary
        iframe.frameBorder = "0";

        const paymentContainer = document.getElementById('paymentContainer');
        paymentContainer.innerHTML = ''; // Clear previous content
        paymentContainer.appendChild(iframe); // Append iframe

        hideModalElements();
    }

    // Hide modal elements after loading iframe
    function hideModalElements() {
        document.querySelector(".show").style.display = "none";
        document.getElementById('modalRoomNumber').style.display = "none";
        document.getElementById('modalRoomName').style.display = "none";
        document.getElementById('modalRoomStatus').style.display = "none";
        document.getElementById('submit_button').style.display = "none";
    }
});

        
        // Helper function to show toast notifications
        function showToast(message, color) {
            Toastify({
                text: message,
                duration: 3000,
                gravity: "top",
                position: "center",
                style: { background: color },
            }).showToast();
        }
        </script>
        
</body>

</html>


